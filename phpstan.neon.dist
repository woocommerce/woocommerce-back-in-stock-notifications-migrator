includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # Stubs of integrated plugins, from woocommerce/php-stubs (composer install --working-dir=tools/php-stubs).
    # WooCommerce internals php-stubs/woocommerce-stubs omits; must match its version in composer.lock.
    - tools/php-stubs/vendor/woocommerce/php-stubs/supplements/woocommerce-internal/11.2.0.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    phpVersion: 70400
    # The stubs pin WC_VERSION to the stubbed release, which would make the minimum-version
    # guard look always true.
    dynamicConstantNames:
        - WC_VERSION
    parallel:
        maximumNumberOfProcesses: 2
    paths:
        - back-in-stock-notifications-migrator-for-woocommerce.php
        - uninstall.php
        - src
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
        # In tools/php-stubs: it requires wordpress-stubs 6, which the root composer.json cannot install.
        - tools/php-stubs/vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
