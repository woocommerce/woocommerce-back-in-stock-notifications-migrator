{
	"name": "woocommerce-back-in-stock-notifications-migrator",
	"title": "Back In Stock Notifications Migrator for WooCommerce",
	"version": "1.0.1",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "^24.22.3"
	},
	"private": true,
	"description": "Moves Back In Stock Notifications data into WooCommerce Core's built-in stock notifications.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/woocommerce/woocommerce-back-in-stock-notifications-migrator.git"
	},
	"scripts": {
		"build:zip": "bash bin/build-zip.sh --deploy",
		"changelog": "composer install --quiet && composer exec -- changelogger",
		"changelog:check": "bash bin/check_changelog.sh",
		"lint:php": "composer run lint:php --",
		"lint:php:syntax": "composer run lint:php:syntax --",
		"lint:php:fix": "composer run lint:php:fix --",
		"phpstan": "composer run phpstan --",
		"test:php": "composer run test:php --",
		"test:isolated": "composer run test:isolated --",
		"wp-env": "pnpm dlx @wordpress/env@12.0.0",
		"wp-env:test": "pnpm run wp-env --config .wp-env.test.json",
		"env:dev:start": "pnpm run wp-env start",
		"env:dev:stop": "pnpm run wp-env stop",
		"env:dev:destroy": "pnpm run wp-env destroy",
		"env:test:start": "pnpm run wp-env:test start",
		"env:test:stop": "pnpm run wp-env:test stop",
		"env:test:reset": "pnpm run wp-env:test clean all",
		"env:test:destroy": "pnpm run wp-env:test destroy",
		"test:php:env:setup": "bash bin/prepare-test-environment.sh",
		"test:php:env": "pnpm run wp-env:test run cli --env-cwd=wp-content/plugins/back-in-stock-notifications-migrator-for-woocommerce env WP_TESTS_DIR=/wordpress-phpunit WC_CORE_DIR=/var/www/html/woocommerce-source/plugins/woocommerce php vendor/bin/phpunit --fail-on-empty-test-suite"
	}
}
