{
	"name": "woocommerce/woocommerce-back-in-stock-notifications-migrator",
	"description": "Moves Back In Stock Notifications data into WooCommerce Core's built-in stock notifications.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"woocommerce/woocommerce-sniffs": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^3.1",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/woocommerce-stubs": "^11.1",
		"automattic/jetpack-changelogger": "^6.0"
	},
	"autoload": {
		"psr-4": {
			"Automattic\\WooCommerce\\StockNotificationsMigrator\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Automattic\\WooCommerce\\StockNotificationsMigrator\\Tests\\": "tests/php/"
		},
		"classmap": [
			"tools/changelogger/"
		]
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"extra": {
		"changelogger": {
			"changelog": "changelog.txt",
			"changes-dir": "changelog",
			"types": {
				"add": "Add",
				"fix": "Fix",
				"tweak": "Tweak",
				"dev": "Dev"
			},
			"ordering": [
				"subheading"
			],
			"formatter": {
				"class": "SomewhereWarm\\Changelogger\\Changelog_Formatter",
				"title": "*** Back In Stock Notifications Migrator for WooCommerce ***"
			},
			"versioning": "semver"
		}
	},
	"scripts": {
		"lint:php": [
			"Composer\\Config::disableProcessTimeout",
			"phpcs"
		],
		"lint:php:syntax": [
			"Composer\\Config::disableProcessTimeout",
			"parallel-lint --exclude vendor --exclude node_modules ."
		],
		"lint:php:fix": [
			"Composer\\Config::disableProcessTimeout",
			"phpcbf"
		],
		"phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=2G",
		"test:php": [
			"Composer\\Config::disableProcessTimeout",
			"@test:php:unit",
			"@test:php:isolated"
		],
		"test:php:unit": [
			"Composer\\Config::disableProcessTimeout",
			"phpunit -c phpunit.xml.dist --fail-on-empty-test-suite"
		],
		"test:php:isolated": [
			"Composer\\Config::disableProcessTimeout",
			"phpunit -c tests/isolated/phpunit.xml.dist --fail-on-empty-test-suite"
		],
		"build:zip": "bash bin/build-zip.sh",
		"lint:phpstan:baseline:update": "@phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
		"check:php": [
			"@lint:php:syntax",
			"@lint:php"
		],
		"lint:phpcs": "@lint:php",
		"lint:phpcs:fix": "@lint:php:fix",
		"lint:phpstan": "@phpstan",
		"test": "@test:php",
		"test:isolated": "@test:php:isolated"
	}
}
