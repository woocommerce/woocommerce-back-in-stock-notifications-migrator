{
	"name": "woocommerce/woocommerce-back-in-stock-notifications-migrator",
	"description": "Moves Back In Stock Notifications data into WooCommerce Core's built-in stock notifications.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"woocommerce/woocommerce-sniffs": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^3.1",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/woocommerce-stubs": "^11.1"
	},
	"autoload": {
		"psr-4": {
			"Automattic\\WooCommerce\\StockNotificationsMigrator\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Automattic\\WooCommerce\\StockNotificationsMigrator\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint:phpcs": "phpcs",
		"lint:php": "parallel-lint --exclude vendor --exclude node_modules .",
		"lint:phpcs:fix": "phpcbf",
		"test": "phpunit",
		"build:zip": "bash bin/build-zip.sh",
		"lint:phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=2G",
		"lint:phpstan:baseline:update": "@lint:phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
		"check:php": [
			"@lint:php",
			"@lint:phpcs"
		]
	}
}
